/// Mock ASR 引擎实现
/// 用于开发调试，定时产生假数据，模拟流式输出
import 'dart:async';
import 'dart:developer';

class MockASR implements ASREngine {
  @override
  final String engineId = 'mock_asr';
  
  @override
  final String displayName = 'Mock ASR (测试用)';
  
  @override
  bool isInitialized = false;
  
  @override
  bool isRunning = false;
  
  @override
  String currentLanguage = 'en';
  
  @override
  final List<String> supportedLanguages = ['en', 'ja', 'zh', 'ko'];
  
  // 内部状态
  Timer? _timer;
  int _counter = 0;
  Function(ASRResult)? _onResult;
  Function(Object, StackTrace)? _onError;
  
  // Mock 文本数据池（英文和日文混合）
  static final List<String> _mockTextsEn = [
    'Hello, this is a test.',
    'The weather is nice today.',
    'I am learning Japanese.',
    'Real-time translation works great.',
    'This is a mock ASR engine.',
    'Flutter is awesome.',
    'Voice recognition in progress.',
    'System audio capture active.',
  ];
  
  static final List<String> _mockTextsJa = [
    'こんにちは、これはテストです。',
    '今日は天気がいいですね。',
    '私は日本語を勉強しています。',
    'リアルタイム翻訳が動作しています。',
    'これはモックASRエンジンです。',
    'Flutterは素晴らしいです。',
    '音声認識が進行中です。',
    'システムオーディオキャプチャがアクティブです。',
  ];
  
  static final List<String> _mockTextsZh = [
    '你好，这是一个测试。',
    '今天天气真不错。',
    '我正在学习日语。',
    '实时翻译工作正常。',
    '这是一个模拟ASR引擎。',
    'Flutter非常棒。',
    '语音识别进行中。',
    '系统音频捕获已激活。',
  ];
  
  @override
  Future<void> initialize({
    String? modelPath,
    String language = 'en',
    Map<String, dynamic> config = const {},
  }) async {
    // 模拟初始化延迟
    await Future.delayed(const Duration(milliseconds: 300));
    
    currentLanguage = language;
    isInitialized = true;
    debugPrint('[MockASR] Initialized with language: $language');
  }
  
  @override
  Future<void> start({
    required Function(ASRResult) onResult,
    required Function(Object error, StackTrace stack) onError,
  }) async {
    if (!isInitialized) {
      throw StateError('MockASR not initialized');
    }
    
    if (isRunning) {
      return;
    }
    
    _onResult = onResult;
    _onError = onError;
    isRunning = true;
    _counter = 0;
    
    debugPrint('[MockASR] Started');
    
    // 启动定时器，每 2-4 秒产生一个结果
    _timer = Timer.periodic(const Duration(seconds: 3), _generateMockResult);
    
    // 立即产生第一个结果
    _generateMockResult(_timer!);
  }
  
  void _generateMockResult(Timer timer) {
    if (!isRunning || _onResult == null) {
      timer.cancel();
      return;
    }
    
    _counter++;
    
    // 根据当前语言选择文本池
    final texts = switch (currentLanguage) {
      'ja' => _mockTextsJa,
      'zh' => _mockTextsZh,
      _ => _mockTextsEn,
    };
    
    final text = texts[_counter % texts.length];
    final isFinal = _counter % 3 == 0; // 每3个结果有一个是最终结果
    
    // 模拟流式输出：先给部分结果，再给最终结果
    if (!isFinal && _counter % 3 != 1) {
      // 中间片段
      _onResult!(ASRResult(
        text: text.substring(0, (text.length * 0.6).round()),
        isFinal: false,
        confidence: 0.85,
        timestamp: Duration(seconds: _counter * 3),
        language: currentLanguage,
      ));
    }
    
    // 最终结果
    _onResult!(ASRResult(
      text: text,
      isFinal: true,
      confidence: 0.95,
      timestamp: Duration(seconds: _counter * 3),
      language: currentLanguage,
    ));
  }
  
  @override
  Future<void> stop() async {
    isRunning = false;
    _timer?.cancel();
    _timer = null;
    _onResult = null;
    _onError = null;
    debugPrint('[MockASR] Stopped');
  }
  
  @override
  Future<void> pushAudio(List<int> audioData) async {
    // Mock 引擎不需要实际处理音频，只需确保在运行状态
    if (!isRunning) {
      debugPrint('[MockASR] pushAudio called but not running');
    }
  }
  
  @override
  Future<void> switchLanguage(String language) async {
    if (!supportedLanguages.contains(language)) {
      throw ArgumentError('Unsupported language: $language');
    }
    currentLanguage = language;
    debugPrint('[MockASR] Language switched to: $language');
  }
  
  @override
  Future<void> dispose() async {
    await stop();
    isInitialized = false;
    debugPrint('[MockASR] Disposed');
  }
  
  @override
  Map<String, dynamic> getStatus() {
    return {
      'engineId': engineId,
      'displayName': displayName,
      'isInitialized': isInitialized,
      'isRunning': isRunning,
      'currentLanguage': currentLanguage,
      'supportedLanguages': supportedLanguages,
      'counter': _counter,
    };
  }
}