/// 翻译服务单元测试
/// 验证 Mock 引擎链路完整性
import 'package:flutter_test/flutter_test.dart';
import 'package:live_translate/core/engine/engine.dart';
import 'package:live_translate/core/service/translation_service.dart';

void main() {
  group('TranslationService', () {
    // Test 1: Mock ASR 引擎直接测试（避免单例冲突）
    test('MockASR 应产生模拟识别结果', () async {
      final mockAsr = MockASR();
      
      await mockAsr.initialize(language: 'en');
      expect(mockAsr.isInitialized, true);
      
      final results = <ASRResult>[];
      await mockAsr.start(
        onResult: (r) => results.add(r),
        onError: (e, s) => fail('ASR error: $e'),
      );
      
      // 等待几个定时器周期
      await Future.delayed(const Duration(milliseconds: 100));
      
      await mockAsr.stop();
      
      expect(results, isNotEmpty);
      expect(results.any((r) => r.isFinal), true);
    });
    
    // Test 2: Mock MT 引擎直接测试
    test('MockMT 应产生带前缀的翻译结果', () async {
      final mockMt = MockMT();
      
      await mockMt.initialize(sourceLang: 'en', targetLang: 'ja');
      expect(mockMt.isInitialized, true);
      
      final chunks = <MTChunk>[];
      MTResult? finalResult;
      
      await mockMt.translateStream(
        text: 'Hello world',
        onChunk: (c) => chunks.add(c),
        onComplete: (r) => finalResult = r,
        onError: (e, s) => fail('MT error: $e'),
      );
      
      expect(chunks, isNotEmpty);
      expect(finalResult, isNotNull);
      expect(finalResult!.translatedText, startsWith('【日】'));
      expect(finalResult!.sourceText, 'Hello world');
    });
    
    // Test 3: EngineManager 独立测试（不依赖 TranslationService 的单例）
    test('EngineManager 切换引擎应正确释放旧引擎', () async {
      // 使用工厂模式避免单例干扰
      final manager = EngineManager();
      
      // 先释放可能已有的引擎
      await manager.disposeAll();
      
      // 注册两个 Mock 引擎（使用唯一 ID 避免与预注册冲突）
      manager.registerASREngine('test_engine_a', () => MockASR());
      manager.registerASREngine('test_engine_b', () => MockASR());
      
      // 切换到第一个
      await manager.switchASREngine(engineId: 'test_engine_a');
      expect(manager.currentASRId, 'test_engine_a');
      final firstEngine = manager.currentASR;
      
      // 切换到第二个
      await manager.switchASREngine(engineId: 'test_engine_b');
      expect(manager.currentASRId, 'test_engine_b');
      expect(manager.currentASR, isNot(firstEngine));
      
      // 释放所有
      await manager.disposeAll();
      expect(manager.currentASR, isNull);
    });
  });
}