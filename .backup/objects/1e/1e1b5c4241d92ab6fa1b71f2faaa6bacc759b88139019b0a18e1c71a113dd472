/// 悬浮窗覆盖层 UI
/// 独立的 Flutter 引擎入口点，通过 FlutterScreenOverlay.overlayListener 接收主引擎数据
/// 使用 @pragma('vm:entry-point') 标记
import 'dart:async';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:flutter_screen_overlay/flutter_screen_overlay.dart' as overlay;
// ignore: unused_import
import 'package:system_audio_recorder/system_audio_recorder.dart';

/// 悬浮窗入口点（必须标记为 vm:entry-point）
@pragma('vm:entry-point')
void overlayMain() {
  // 设置系统 UI 覆盖样式
  SystemChrome.setSystemUIOverlayStyle(const SystemUiOverlayStyle(
    statusBarColor: Colors.transparent,
    statusBarIconBrightness: Brightness.light,
    systemNavigationBarColor: Colors.transparent,
    systemNavigationBarIconBrightness: Brightness.light,
  ));
  
  runApp(const OverlayApp());
}

class OverlayApp extends StatelessWidget {
  const OverlayApp({super.key});
  
  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: '实时翻译 - 悬浮窗',
      theme: ThemeData(
        brightness: Brightness.dark,
        scaffoldBackgroundColor: Colors.transparent,
        fontFamily: 'NotoSansSC',
      ),
      home: const OverlayScreen(),
    );
  }
}

class OverlayScreen extends StatefulWidget {
  const OverlayScreen({super.key});
  
  @override
  State<OverlayScreen> createState() => _OverlayScreenState();
}

class _OverlayScreenState extends State<OverlayScreen> with WidgetsBindingObserver {
  // 当前显示的文本
  String _sourceText = '';
  String _translatedText = '';
  bool _isFinal = false;
  bool _isVisible = true;
  
  // 字号设置（默认 16sp，可调节范围 12-28）
  double _fontSize = 16.0;
  
  // 位置设置
  OverlayPosition _position = OverlayPosition.bottomCenter;
  
  // 数据监听订阅
  StreamSubscription<dynamic>? _dataSubscription;
  
  // 透明度
  double _opacity = 0.95;
  
  // 防抖定时器（虽然主引擎已做 100ms 节流，这里再加一层保险）
  Timer? _debounceTimer;
  String _pendingSource = '';
  String _pendingTranslated = '';
  bool _pendingFinal = false;
  
  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addObserver(this);
    _initializeOverlay();
  }
  
  @override
  void dispose() {
    WidgetsBinding.instance.removeObserver(this);
    _dataSubscription?.cancel();
    _debounceTimer?.cancel();
    super.dispose();
  }
  
  /// 初始化悬浮窗数据监听
  Future<void> _initializeOverlay() async {
    try {
      // 监听主引擎发送的共享数据
      _dataSubscription = overlay.FlutterScreenOverlay.overlayListener.listen(
        (dynamic data) => _onDataReceived(data as Map<String, dynamic>),
        onError: (error) {
          debugPrint('[Overlay] Data stream error: $error');
        },
        onDone: () {
          debugPrint('[Overlay] Data stream closed');
        },
      );
      
      debugPrint('[Overlay] Initialized and listening for data');
    } catch (e, stack) {
      debugPrint('[Overlay] Initialization error: $e\n$stack');
    }
  }
  
  /// 接收主引擎发送的数据
  void _onDataReceived(Map<String, dynamic> data) {
    debugPrint('[Overlay] Received data: $data');
    
    // 提取数据字段
    final sourceText = data['sourceText'] as String? ?? '';
    final translatedText = data['translatedText'] as String? ?? '';
    final isFinal = data['isFinal'] as bool? ?? false;
    
    // 防抖处理（双重保险，主引擎已有 100ms 节流）
    _pendingSource = sourceText;
    _pendingTranslated = translatedText;
    _pendingFinal = isFinal;
    
    _debounceTimer?.cancel();
    _debounceTimer = Timer(const Duration(milliseconds: 50), () {
      if (mounted) {
        setState(() {
          _sourceText = _pendingSource;
          _translatedText = _pendingTranslated;
          _isFinal = _pendingFinal;
        });
      }
    });
  }
  
  /// 更新字号
  void _updateFontSize(double size) {
    setState(() {
      _fontSize = size.clamp(12.0, 28.0);
    });
    // 保存设置（实际项目中应持久化到 SharedPreferences）
  }
  
  /// 更新位置
  void _updatePosition(OverlayPosition position) {
    setState(() {
      _position = position;
    });
    // 转换自定义枚举到插件的 OverlayPosition
    final pluginPosition = _convertToPluginPosition(position);
    overlay.FlutterScreenOverlay.moveOverlay(pluginPosition);
  }
  
  /// 更新透明度
  void _updateOpacity(double opacity) {
    setState(() {
      _opacity = opacity.clamp(0.3, 1.0);
    });
  }
  
  /// 切换可见性
  void _toggleVisibility() {
    setState(() {
      _isVisible = !_isVisible;
    });
    if (_isVisible) {
      // 显示悬浮窗，使用默认配置
      overlay.FlutterScreenOverlay.showOverlay(
        height: overlay.WindowSize.matchParent,
        width: overlay.WindowSize.matchParent,
        alignment: overlay.OverlayAlignment.center,
        flag: overlay.OverlayFlag.defaultFlag,
        overlayTitle: '实时翻译',
        overlayContent: '字幕显示中',
        enableDrag: false,
      );
    } else {
      overlay.FlutterScreenOverlay.closeOverlay();
    }
  }
  
  @override
  void didChangeAppLifecycleState(AppLifecycleState state) {
    super.didChangeAppLifecycleState(state);
    debugPrint('[Overlay] Lifecycle state: $state');
  }
  
  @override
  Widget build(BuildContext context) {
    // 如果没有文本且不可见，返回空容器
    if (!_isVisible && _sourceText.isEmpty && _translatedText.isEmpty) {
      return const SizedBox.shrink();
    }
    
    return Material(
      color: Colors.transparent,
      child: _buildOverlayContent(),
    );
  }
  
  Widget _buildOverlayContent() {
    // 根据位置决定对齐方式
    final alignment = _getAlignment(_position);
    final padding = _getPadding(_position);
    
    return Align(
      alignment: alignment,
      child: Padding(
        padding: padding,
        child: AnimatedOpacity(
          opacity: _isVisible ? _opacity : 0.0,
          duration: const Duration(milliseconds: 200),
          child: AnimatedContainer(
            duration: const Duration(milliseconds: 300),
            curve: Curves.easeOutCubic,
            constraints: BoxConstraints(
              maxWidth: MediaQuery.of(context).size.width * 0.9,
              minWidth: 200,
            ),
            decoration: BoxDecoration(
              color: const Color(0xFF1E1E1E).withValues(alpha: 0.95),
              borderRadius: BorderRadius.circular(16),
              border: Border.all(
                color: _isFinal ? Colors.green.withValues(alpha: 0.5) : Colors.blue.withValues(alpha: 0.5),
                width: 1.5,
              ),
              boxShadow: [
                BoxShadow(
                  color: Colors.black.withValues(alpha: 0.4),
                  blurRadius: 20,
                  offset: const Offset(0, 8),
                  spreadRadius: 2,
                ),
                if (_isFinal)
                  BoxShadow(
                    color: Colors.green.withValues(alpha: 0.2),
                    blurRadius: 15,
                    spreadRadius: 2,
                  )
                else
                  BoxShadow(
                    color: Colors.blue.withValues(alpha: 0.15),
                    blurRadius: 15,
                    spreadRadius: 2,
                  ),
              ],
            ),
            child: ClipRRect(
              borderRadius: BorderRadius.circular(16),
              child: Column(
                mainAxisSize: MainAxisSize.min,
                crossAxisAlignment: CrossAxisAlignment.stretch,
                children: [
                  // 顶部控制栏
                  _buildControlBar(),
                  
                  // 内容区域
                  Padding(
                    padding: const EdgeInsets.fromLTRB(16, 0, 16, 16),
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        // 源语言文本
                        if (_sourceText.isNotEmpty) ...[
                          _buildTextRow(
                            label: '原文',
                            text: _sourceText,
                            color: Colors.white.withValues(alpha: 0.9),
                            icon: Icons.mic_rounded,
                            iconColor: Colors.blue[300]!,
                          ),
                          if (_translatedText.isNotEmpty)
                            const SizedBox(height: 8),
                        ],
                        
                        // 翻译文本
                        if (_translatedText.isNotEmpty) ...[
                          _buildTextRow(
                            label: '译文',
                            text: _translatedText,
                            color: Colors.blue[100]!,
                            icon: Icons.translate_rounded,
                            iconColor: Colors.blue[300]!,
                          ),
                        ],
                        
                        // 空状态提示
                        if (_sourceText.isEmpty && _translatedText.isEmpty) ...[
                          Center(
                            child: Padding(
                              padding: const EdgeInsets.symmetric(vertical: 24),
                              child: Column(
                                children: [
                                  Icon(
                                    Icons.translate_rounded,
                                    size: 32,
                                    color: Colors.grey[600],
                                  ),
                                  const SizedBox(height: 8),
                                  Text(
                                    '等待语音输入...',
                                    style: TextStyle(
                                      color: Colors.grey[500],
                                      fontSize: _fontSize * 0.9,
                                    ),
                                  ),
                                ],
                              ),
                            ),
                          ),
                        ],
                      ],
                    ),
                  ),
                ],
              ),
            ),
          ),
        ),
      ),
    );
  }
  
  /// 顶部控制栏
  Widget _buildControlBar() {
    return Container(
      height: 40,
      decoration: BoxDecoration(
        color: Colors.black.withValues(alpha: 0.3),
        borderRadius: const BorderRadius.vertical(top: Radius.circular(16)),
      ),
      child: Row(
        children: [
          // 拖拽手柄 / 状态指示
          Container(
            width: 40,
            alignment: Alignment.center,
            child: Container(
              width: 24,
              height: 4,
              decoration: BoxDecoration(
                color: _isFinal ? Colors.greenAccent : Colors.blue,
                borderRadius: BorderRadius.circular(2),
              ),
            ),
          ),
          
          const Spacer(),
          
          // 字号调节按钮
          _buildIconButton(
            icon: Icons.text_decrease_rounded,
            onTap: () => _updateFontSize(_fontSize - 1),
            tooltip: '减小字号',
          ),
          _buildIconButton(
            icon: Icons.text_increase_rounded,
            onTap: () => _updateFontSize(_fontSize + 1),
            tooltip: '增大字号',
          ),
          
          // 位置切换
          _buildIconButton(
            icon: Icons.vertical_align_center_rounded,
            onTap: _cyclePosition,
            tooltip: '切换位置',
          ),
          
          // 透明度调节
          _buildIconButton(
            icon: Icons.opacity_rounded,
            onTap: _cycleOpacity,
            tooltip: '调节透明度',
          ),
          
          // 关闭/隐藏
          _buildIconButton(
            icon: Icons.close_rounded,
            onTap: _toggleVisibility,
            tooltip: _isVisible ? '隐藏悬浮窗' : '显示悬浮窗',
            color: Colors.redAccent,
          ),
        ],
      ),
    );
  }
  
  Widget _buildIconButton({
    required IconData icon,
    required VoidCallback onTap,
    required String tooltip,
    Color? color,
  }) {
    return Tooltip(
      message: tooltip,
      child: InkWell(
        onTap: onTap,
        borderRadius: BorderRadius.circular(8),
        child: Container(
          width: 40,
          height: 40,
          alignment: Alignment.center,
          child: Icon(
            icon,
            size: 20,
            color: color ?? Colors.grey[300],
          ),
        ),
      ),
    );
  }
  
  /// 文本行构建
  Widget _buildTextRow({
    required String label,
    required String text,
    required Color color,
    required IconData icon,
    required Color iconColor,
  }) {
    return Row(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Padding(
          padding: const EdgeInsets.only(top: 2),
          child: Icon(icon, size: 16, color: iconColor),
        ),
        const SizedBox(width: 8),
        Expanded(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(
                label,
                style: TextStyle(
                  color: Colors.grey[500],
                  fontSize: _fontSize * 0.7,
                  fontWeight: FontWeight.w500,
                ),
              ),
              const SizedBox(height: 2),
              Text(
                text,
                style: TextStyle(
                  color: color,
                  fontSize: _fontSize,
                  height: 1.5,
                  fontWeight: FontWeight.w400,
                ),
                maxLines: 5,
                overflow: TextOverflow.ellipsis,
              ),
            ],
          ),
        ),
      ],
    );
  }
  
  /// 获取对齐方式
  Alignment _getAlignment(OverlayPosition position) {
    switch (position) {
      case OverlayPosition.topLeft:
        return Alignment.topLeft;
      case OverlayPosition.topCenter:
        return Alignment.topCenter;
      case OverlayPosition.topRight:
        return Alignment.topRight;
      case OverlayPosition.centerLeft:
        return Alignment.centerLeft;
      case OverlayPosition.center:
        return Alignment.center;
      case OverlayPosition.centerRight:
        return Alignment.centerRight;
      case OverlayPosition.bottomLeft:
        return Alignment.bottomLeft;
      case OverlayPosition.bottomCenter:
        return Alignment.bottomCenter;
      case OverlayPosition.bottomRight:
        return Alignment.bottomRight;
    }
  }
  
  /// 获取边距
  EdgeInsets _getPadding(OverlayPosition position) {
    const double edgePadding = 16;
    const double centerPadding = 24;
    
    switch (position) {
      case OverlayPosition.topLeft:
        return const EdgeInsets.only(top: 60, left: edgePadding); // 避开状态栏
      case OverlayPosition.topCenter:
        return const EdgeInsets.only(top: 60);
      case OverlayPosition.topRight:
        return const EdgeInsets.only(top: 60, right: edgePadding);
      case OverlayPosition.centerLeft:
        return const EdgeInsets.only(left: edgePadding);
      case OverlayPosition.center:
        return const EdgeInsets.all(centerPadding);
      case OverlayPosition.centerRight:
        return const EdgeInsets.only(right: edgePadding);
      case OverlayPosition.bottomLeft:
        return const EdgeInsets.only(bottom: 100, left: edgePadding); // 避开导航栏
      case OverlayPosition.bottomCenter:
        return const EdgeInsets.only(bottom: 100);
      case OverlayPosition.bottomRight:
        return const EdgeInsets.only(bottom: 100, right: edgePadding);
    }
  }
  
  /// 循环切换位置
  void _cyclePosition() {
    final positions = OverlayPosition.values;
    final currentIndex = positions.indexOf(_position);
    final nextIndex = (currentIndex + 1) % positions.length;
    _updatePosition(positions[nextIndex]);
  }
  
  /// 循环切换透明度
  void _cycleOpacity() {
    const levels = [0.6, 0.8, 0.95, 1.0];
    final currentIndex = levels.indexWhere((l) => (_opacity - l).abs() < 0.05);
    final nextIndex = (currentIndex + 1) % levels.length;
    _updateOpacity(levels[nextIndex]);
  }

  /// 将自定义 OverlayPosition 转换为插件的 OverlayPosition
  overlay.OverlayPosition _convertToPluginPosition(OverlayPosition position) {
    switch (position) {
      case OverlayPosition.topLeft:
        return overlay.OverlayPosition(0, 0);
      case OverlayPosition.topCenter:
        return overlay.OverlayPosition(0, 1);
      case OverlayPosition.topRight:
        return overlay.OverlayPosition(1, 0);
      case OverlayPosition.centerLeft:
        return overlay.OverlayPosition(0, 2);
      case OverlayPosition.center:
        return overlay.OverlayPosition(1, 2);
      case OverlayPosition.centerRight:
        return overlay.OverlayPosition(2, 2);
      case OverlayPosition.bottomLeft:
        return overlay.OverlayPosition(0, 3);
      case OverlayPosition.bottomCenter:
        return overlay.OverlayPosition(1, 3);
      case OverlayPosition.bottomRight:
        return overlay.OverlayPosition(2, 3);
    }
  }
}

/// 悬浮窗位置枚举
enum OverlayPosition {
  topLeft,
  topCenter,
  topRight,
  centerLeft,
  center,
  centerRight,
  bottomLeft,
  bottomCenter,
  bottomRight,
}